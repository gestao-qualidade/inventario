# URL do Web App do Apps Script (termina em /exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Mesmo valor mostrado no log do setupInicial() (propriedade API_SECRET do Apps Script)
APPS_SCRIPT_SECRET=
# Chave para assinar o cookie de sessão (gere com: openssl rand -base64 32)
SESSION_SECRET=
